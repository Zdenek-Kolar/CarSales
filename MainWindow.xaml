<Window x:Class="CarSales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarSales"
        mc:Ignorable="d"
        Title="Prodej vozů" Height="650" Width="1025">
    <Grid>
        <TextBox Name="FileNameTextBox" Text="Soubor ke zpracování" Margin="50,25,0,0" Width="300" Height="25"
                 TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Button x:Name="BrowseButton" Content="Vyberte soubor" Margin="370,25,0,0"  Width="100" Height="25"
                HorizontalAlignment="Left" VerticalAlignment="Top" Click="BrowseButton_Click" />
        <TextBlock Name="ErrorMessageTextBox" Margin="500, 30, 0, 0" Width="500"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Red" />
        <TextBlock Text="Tabulka prodaných vozů" FontSize="14" Margin="55, 75, 0, 0" FontWeight="Medium" />
        <DataGrid x:Name="salesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50, 100, 0, 0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Název modelu" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="Datum prodeje" Binding="{Binding Date, StringFormat=\{0:d. MM. yyyy\}}" Width="150" />
                <DataGridTextColumn Header="Cena" Binding="{Binding FormattedPrice}" Width="100" />
                <DataGridTextColumn Header="DPH" Binding="{Binding Tax}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Celkový prodej vozů o víkendu" FontSize="14" Margin="655, 75, 0, 0" FontWeight="Medium" />
        <DataGrid x:Name="weekendTotalSalesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="650, 100, 0, 0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="150">
                    <DataGridTemplateColumn.Header>
                        <StackPanel>
                            <TextBlock>Název modelu</TextBlock>
                            <TextBlock>Cena bez DPH</TextBlock>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding FormattedTotalPrice}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="150">
                    <DataGridTemplateColumn.Header>
                        <StackPanel>
                            <TextBlock></TextBlock>
                            <TextBlock>Cena s DPH</TextBlock>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="" />
                                <TextBlock Text="{Binding FormattedTotalPriceWithTax}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
